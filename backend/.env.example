# Copy to .env for local (Docker-less) development. docker-compose.yml sets
# its own equivalents for the containerized stack - see its `environment:`
# blocks, which point at the postgres/neo4j services instead of localhost.

ENVIRONMENT=development
LOG_LEVEL=INFO

# docs/ARCHITECTURE.md §8: PostgreSQL+PostGIS is the documented target.
# Falls back to a local SQLite file if unset - see app/db/session.py.
DATABASE_URL=postgresql://tracex:tracex_dev_password@localhost:5432/tracex

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tracex_dev_password

JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240

PII_HASH_PEPPER=change-me-to-a-long-random-value

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SYNTHETIC_RANDOM_SEED=42
